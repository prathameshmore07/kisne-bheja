# ==========================================
# Kisne Bheja — Secure Git Ignore Policy
# ==========================================

# ------------------------------------------
# 1. Environment & API Secrets (CRITICAL)
# ------------------------------------------
# Explicitly ignore all active environment variable files
.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
.env.*
*.env
*.env.local

# Allow ONLY the template placeholder file to be tracked
!.env.example

# Cryptographic keys and certificates
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
credentials.json
secrets.json
service-account*.json

# ------------------------------------------
# 2. Dependencies
# ------------------------------------------
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ------------------------------------------
# 3. Next.js & Build Artifacts
# ------------------------------------------
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# ------------------------------------------
# 4. Logs & Debug Traces
# ------------------------------------------
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*

# ------------------------------------------
# 5. Testing & Coverage
# ------------------------------------------
coverage/
.nyc_output/
*.lcov

# ------------------------------------------
# 6. Operating System Files
# ------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# ------------------------------------------
# 7. IDE & Editor Metadata
# ------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
*~

# ------------------------------------------
# 8. Hosting & Cloud Deployments
# ------------------------------------------
.vercel

# ------------------------------------------
# 9. Private Agent Metadata
# ------------------------------------------
AGENTS.md
CLAUDE.md
agents.md
claude.md
